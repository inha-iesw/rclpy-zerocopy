diff --git a/src/agnocastlib/test/unit/test_agnocast_context.cpp b/src/agnocastlib/test/unit/test_agnocast_context.cpp
index 02e9d7b..b3922c1 100644
--- a/src/agnocastlib/test/unit/test_agnocast_context.cpp
+++ b/src/agnocastlib/test/unit/test_agnocast_context.cpp
@@ -1,10 +1,13 @@
 #include "agnocast/node/agnocast_context.hpp"
 
 #include <gtest/gtest.h>
+#include <rcl/error_handling.h>
 #include <rcl/logging.h>
 #include <rcutils/logging.h>
 #include <rcutils/logging_macros.h>
 
+#include <stdexcept>
+
 // =========================================
 // agnocast::Context --disable-stdout-logs tests
 // =========================================
@@ -91,3 +94,132 @@ TEST_F(AgnocastContextStdoutLogsTest, flag_after_double_dash_terminator_is_ignor
 
   EXPECT_FALSE(output.empty()) << "Flag after -- must be ignored; expected stdout output";
 }
+
+namespace
+{
+void host_output_handler(
+  const rcutils_log_location_t *, int, const char *, rcutils_time_point_value_t, const char *,
+  va_list *)
+{
+}
+}  // namespace
+
+class AgnocastContextLoggingOwnershipTest : public ::testing::Test
+{
+protected:
+  void SetUp() override
+  {
+    agnocast::shutdown();
+    original_handler_ = rcutils_logging_get_output_handler();
+    auto arguments = agnocast::parse_arguments({});
+    auto allocator = rcl_get_default_allocator();
+    ASSERT_EQ(
+      rcl_logging_configure_with_output_handler(
+        arguments.get(), &allocator, rcl_logging_multiple_output_handler),
+      RCL_RET_OK);
+    rcutils_logging_set_output_handler(host_output_handler);
+  }
+
+  void TearDown() override
+  {
+    agnocast::shutdown();
+    EXPECT_EQ(rcl_logging_fini(), RCL_RET_OK);
+    rcl_reset_error();
+    rcutils_logging_set_output_handler(original_handler_);
+  }
+
+  agnocast::InitOptions embedded_options()
+  {
+    agnocast::InitOptions options;
+    options.configure_logging = false;
+    return options;
+  }
+
+  rcutils_logging_output_handler_t original_handler_;
+};
+
+TEST_F(AgnocastContextLoggingOwnershipTest, shutdown_without_init_preserves_host_logging)
+{
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, embedded_lifetime_preserves_host_logging)
+{
+  agnocast::init(0, nullptr, embedded_options());
+  EXPECT_TRUE(agnocast::ok());
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+
+  // A repeated init must not replace the first caller's logging policy.
+  agnocast::init(0, nullptr);
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+  agnocast::shutdown();
+  EXPECT_FALSE(agnocast::ok());
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, default_init_owns_logging_until_shutdown)
+{
+  agnocast::init(0, nullptr);
+  EXPECT_EQ(rcutils_logging_get_output_handler(), rcl_logging_multiple_output_handler);
+  agnocast::init(0, nullptr, embedded_options());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), rcutils_logging_console_output_handler);
+
+  rcutils_logging_set_output_handler(host_output_handler);
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, stopped_context_still_finalizes_owned_logging)
+{
+  agnocast::init(0, nullptr);
+  {
+    // The signal processing thread invalidates the context before explicit shutdown.
+    std::lock_guard<std::mutex> lock(agnocast::g_context_mtx);
+    agnocast::g_context.shutdown();
+  }
+  EXPECT_FALSE(agnocast::ok());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), rcutils_logging_console_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, parse_failure_preserves_host_logging_and_allows_retry)
+{
+  const char * argv[] = {"program", "--ros-args", "--log-level"};
+  EXPECT_THROW(agnocast::init(3, argv, embedded_options()), std::runtime_error);
+  rcl_reset_error();
+  EXPECT_FALSE(agnocast::ok());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+
+  agnocast::init(0, nullptr, embedded_options());
+  EXPECT_TRUE(agnocast::ok());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, new_lifetime_can_change_logging_policy)
+{
+  agnocast::init(0, nullptr, embedded_options());
+  agnocast::shutdown();
+  agnocast::init(0, nullptr);
+  EXPECT_EQ(rcutils_logging_get_output_handler(), rcl_logging_multiple_output_handler);
+  agnocast::shutdown();
+  rcutils_logging_set_output_handler(host_output_handler);
+  agnocast::init(0, nullptr, embedded_options());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
+
+TEST_F(AgnocastContextLoggingOwnershipTest, failed_default_init_does_not_acquire_host_logging)
+{
+  const char * argv[] = {"program", "--ros-args", "--log-level"};
+  EXPECT_THROW(agnocast::init(3, argv), std::runtime_error);
+  rcl_reset_error();
+  EXPECT_FALSE(agnocast::ok());
+  agnocast::shutdown();
+  EXPECT_EQ(rcutils_logging_get_output_handler(), host_output_handler);
+}
