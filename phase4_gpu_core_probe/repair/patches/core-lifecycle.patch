+// One process epoch shares admission across mapper recreation and aliases.
+// A failed permit retains itself, its charge, and the poisoned epoch forever.
+struct ReadEpoch {
+  const std::size_t max_reads;
+  const uint64_t max_bytes;
+  std::atomic<std::size_t> reads{0};
+  std::atomic<bool> poisoned{false};
+  std::mutex admission_mutex;
+  std::atomic<bool> closing{false};
+  ReadEpoch(std::size_t count, uint64_t bytes) : max_reads(count), max_bytes(bytes) {}
+};
+
+struct ReadAdmission {
+  std::shared_ptr<ReadEpoch> epoch;
+  std::shared_ptr<ReadAdmission> failed;
+  std::unique_ptr<buffer_metadata::BufferRef> failed_ref;
+  bool charged = false;
+  explicit ReadAdmission(std::shared_ptr<ReadEpoch> value) : epoch(std::move(value)) {}
+  ~ReadAdmission() { if (charged) epoch->reads.fetch_sub(1); }
+  void retain_failed(const std::shared_ptr<ReadAdmission>& self) noexcept {
+    if (!epoch->poisoned.exchange(true)) {
+      RCUTILS_LOG_ERROR_NAMED("ros2_cuda_ipc_core.subscriber.read_handle",
+                              "GPU read epoch poisoned; retained_reads=%zu limit=%zu",
+                              epoch->reads.load(), epoch->max_reads);
+    }
+    failed = self;
+  }
+};
+
+inline void release_read_ref(
+    std::unique_ptr<buffer_metadata::BufferRef>& ref,
+    const std::shared_ptr<void>& admission) noexcept {
+  auto permit = std::static_pointer_cast<ReadAdmission>(admission);
+  if (permit && permit->failed && ref) {
+    permit->failed_ref = std::move(ref);
+  } else {
+    ref.reset();
+  }
+}
+
+// Keeps exceptional import/allocation paths in the same resource-before-ref order.
+struct ReadRefGuard {
+  std::unique_ptr<buffer_metadata::BufferRef>& ref;
+  std::shared_ptr<ReadAdmission> admission;
+  ~ReadRefGuard() noexcept { release_read_ref(ref, admission); }
+};
+
+inline std::shared_ptr<ReadEpoch> read_epoch(std::size_t count, uint64_t bytes) {
+  if (count == 0 || bytes == 0) throw std::invalid_argument("GPU read limits must be nonzero");
+  struct Registry {
+    std::mutex mutex;
+    std::weak_ptr<ReadEpoch> current;
+  };
+  static auto* registry = new Registry;
+  std::lock_guard<std::mutex> lock(registry->mutex);
+  auto epoch = registry->current.lock();
+  if (epoch) {
+    if (epoch->max_reads != count || epoch->max_bytes != bytes)
+      throw std::logic_error("A live GPU mapper epoch has different limits");
+    return epoch;
+  }
+  epoch = std::make_shared<ReadEpoch>(count, bytes);
+  registry->current = epoch;
+  return epoch;
+}
+
+inline std::shared_ptr<ReadAdmission> admit(const std::shared_ptr<ReadEpoch>& epoch) {
+  auto permit = std::make_shared<ReadAdmission>(epoch);
+  std::lock_guard<std::mutex> lock(epoch->admission_mutex);
+  if (epoch->closing.load()) return {};
+  std::size_t count = epoch->reads.load();
+  while (!epoch->poisoned.load() && count < epoch->max_reads) {
+    if (epoch->reads.compare_exchange_weak(count, count + 1)) {
+      permit->charged = true;
+      if (!epoch->poisoned.load()) return permit;
+      return {};
+    }
+  }
+  return {};
+}
